# Aiptimize environment configuration. Copy to .env and adjust.
# Secrets only ever live here (or in your container manager), never in the app DB.

# --- server -----------------------------------------------------------------
AIPTIMIZE_LISTEN=0.0.0.0:8080
AIPTIMIZE_DATA_DIR=/data
AIPTIMIZE_TZ=Europe/Stockholm
AIPTIMIZE_LOG_LEVEL=info
# json (default) or text
AIPTIMIZE_LOG_FORMAT=json

# --- authentication ---------------------------------------------------------
# If set on first boot, the admin user is seeded and the setup wizard is skipped.
# Leave empty to use the first-run setup screen.
AIPTIMIZE_ADMIN_USERNAME=admin
AIPTIMIZE_ADMIN_PASSWORD=
# Optional 32+ character secret reserved for future signed tokens.
AIPTIMIZE_SESSION_SECRET=
# auto | always | never. auto sets Secure when TLS/trusted proxy is used.
AIPTIMIZE_COOKIE_SECURE=auto
# Set true only behind a reverse proxy that sets X-Forwarded-* headers.
AIPTIMIZE_TRUST_PROXY=false

# --- safety gates -----------------------------------------------------------
# Both the environment gate AND the in-app arming switch are required.
AIPTIMIZE_ENABLE_WRITES=false
AIPTIMIZE_ENABLE_EV_CONTROL=false
# Use in-process simulator adapters instead of real hardware (phases 2+).
AIPTIMIZE_SIMULATOR=false

# --- Zaptec cloud (phase 6) -------------------------------------------------
AIPTIMIZE_ZAPTEC_USERNAME=
AIPTIMIZE_ZAPTEC_PASSWORD=
AIPTIMIZE_ZAPTEC_INSTALLATION_ID=
