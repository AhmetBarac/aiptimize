# Aiptimize environment configuration. Copy to .env and adjust.
# Secrets only ever live here (or in your container manager), never in the app DB.

# --- server -----------------------------------------------------------------
AIPTIMIZE_LISTEN=0.0.0.0:8080
AIPTIMIZE_DATA_DIR=/data
AIPTIMIZE_TZ=Europe/Stockholm
AIPTIMIZE_LOG_LEVEL=info
# json (default) or text
AIPTIMIZE_LOG_FORMAT=json

# --- authentication ---------------------------------------------------------
# If set on first boot, the admin user is seeded and the setup wizard is skipped.
# Leave empty to use the first-run setup screen.
AIPTIMIZE_ADMIN_USERNAME=admin
AIPTIMIZE_ADMIN_PASSWORD=
# Optional 32+ character secret reserved for future signed tokens.
AIPTIMIZE_SESSION_SECRET=
# auto | always | never. auto sets Secure when TLS/trusted proxy is used.
AIPTIMIZE_COOKIE_SECURE=auto
# Set true only behind a reverse proxy that sets X-Forwarded-* headers.
AIPTIMIZE_TRUST_PROXY=false

# --- safety gates -----------------------------------------------------------
# Both the environment gate AND the in-app arming switch are required for
# inverter writes.
AIPTIMIZE_ENABLE_WRITES=false
# EV control: the environment gate follows the charger link and opens once a
# charger is configured and answering. Leave this unset (auto) for that
# behaviour, or set true/false to pin the gate open/closed. The in-app EV arm
# switch is still required either way.
#AIPTIMIZE_ENABLE_EV_CONTROL=auto
# Use in-process simulator adapters instead of real hardware and live prices
# (phases 2+); also useful for demos and end-to-end tests.
AIPTIMIZE_SIMULATOR=false

# --- prices -----------------------------------------------------------------
# Override only for development against a fixture server.
AIPTIMIZE_NORDPOOL_BASE_URL=https://dataportal-api.nordpoolgroup.com/api/DayAheadPrices

# --- forecast ---------------------------------------------------------------
# Open-Meteo needs no key. Override only for development.
AIPTIMIZE_OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# MPPT strings, tariffs and load profile are configured in the web UI.

# --- Zaptec cloud (phase 6) -------------------------------------------------
AIPTIMIZE_ZAPTEC_USERNAME=
AIPTIMIZE_ZAPTEC_PASSWORD=
AIPTIMIZE_ZAPTEC_INSTALLATION_ID=
AIPTIMIZE_ZAPTEC_CHARGER_ID=
AIPTIMIZE_ZAPTEC_BASE_URL=https://api.zaptec.com
